 "subs": [
  {
   "s": 0.1,
   "e": 2.843,
   "text": "宝永四年、\n一七〇七年の冬。",
   "hl": [
    "一七〇七年"
   ]
  },
  {
   "s": 2.843,
   "e": 6.53,
   "text": "富士山の南東の中腹が、\n突然、火を噴きました。",
   "hl": [
    "火を噴きました"
   ]
  },
  {
   "s": 6.53,
   "e": 8.41,
   "text": "わずか四十九日前には、",
   "hl": []
  },
  {
   "s": 8.41,
   "e": 12.241,
   "text": "東海から九州までを大地震が\n襲ったばかりでした。",
   "hl": [
    "大地震"
   ]
  },
  {
   "s": 12.241,
   "e": 14.095,
   "text": "噴火は十六日間続き、",
   "hl": [
    "十六日間"
   ]
  },
  {
   "s": 14.095,
   "e": 17.103,
   "text": "ふもとの村々は、\n厚い砂と灰に埋もれました。",
   "hl": [
    "砂と灰"
   ]
  },
  {
   "s": 17.103,
   "e": 20.925,
   "text": "須走村では、焼けた石が降り、\n家々が燃えたといいます。",
   "hl": [
    "焼けた石"
   ]
  },
  {
   "s": 20.925,
   "e": 22.145,
   "text": "灰は風に乗って、",
   "hl": [
    "江戸"
   ]
  },
  {
   "s": 22.145,
   "e": 25.119,
   "text": "およそ百キロ離れた江戸にも\n降り注ぎます。",
   "hl": [
    "江戸"
   ]
  },
  {
   "s": 25.119,
   "e": 28.378,
   "text": "江戸にも、数センチの灰が\n積もったといわれます。",
   "hl": [
    "数センチの灰"
   ]
  },
  {
   "s": 28.378,
   "e": 30.018,
   "text": "学者の新井白石は、",
   "hl": []
  },
  {
   "s": 30.018,
   "e": 31.631,
   "text": "昼なのに空が暗く、",
   "hl": []
  },
  {
   "s": 31.631,
   "e": 34.732,
   "text": "ろうそくをともして\n講義をしたと書き残しています。",
   "hl": [
    "ろうそく"
   ]
  },
  {
   "s": 34.732,
   "e": 37.006,
   "text": "降り積もった砂で\n田畑はだめになり、",
   "hl": [
    "田畑"
   ]
  },
  {
   "s": 37.006,
   "e": 39.623,
   "text": "川はあふれ、人々は\n長く苦しみました。",
   "hl": []
  },
  {
   "s": 39.623,
   "e": 41.71,
   "text": "砂でせき止められた酒匂川は、",
   "hl": [
    "酒匂川"
   ]
  },
  {
   "s": 41.71,
   "e": 44.368,
   "text": "何年ものあいだ、\n洪水をくり返しました。",
   "hl": [
    "洪水"
   ]
  },
  {
   "s": 44.368,
   "e": 46.983,
   "text": "このとき山の\n中腹にできた大きなくぼみが、",
   "hl": []
  },
  {
   "s": 46.983,
   "e": 49.064,
   "text": "今も見える「宝永火口」\nです。",
   "hl": [
    "宝永火口"
   ]
  },
  {
   "s": 49.064,
   "e": 53.064,
   "text": "火口の横には、「宝永山」\nと呼ばれる小さな山も生まれました。",
   "hl": [
    "宝永山"
   ]
  },
  {
   "s": 53.064,
   "e": 56.904,
   "text": "葛飾北斎も、のちにこの噴火を\n想像して描いています。",
   "hl": [
    "葛飾北斎"
   ]
  },
  {
   "s": 56.904,
   "e": 61.012,
   "text": "それから三百年あまり、\n富士山は一度も噴火していません。",
   "hl": [
    "三百年あまり"
   ]
  },
  {
   "s": 61.012,
   "e": 63.681,
   "text": "けれど、\n富士山はいまも活火山です。",
   "hl": [
    "活火山"
   ]
  },
  {
   "s": 63.681,
   "e": 65.573,
   "text": "美しい山の姿の奥には、",
   "hl": []
  },
  {
   "s": 65.573,
   "e": 68.892,
   "text": "眠っている力が\n隠れているのです。",
   "hl": [
    "眠っている力"
   ]
  }
 ],
