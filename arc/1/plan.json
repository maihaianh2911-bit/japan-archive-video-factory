 "subs": [
  {
   "s": 0.1,
   "e": 4.124,
   "text": "青森県で見つかった、\n三千年前の不思議な土の人形。",
   "hl": [
    "三千年前"
   ]
  },
  {
   "s": 4.124,
   "e": 7.156,
   "text": "大きな目は、まるで\nゴーグルをかけているようです。",
   "hl": [
    "ゴーグル"
   ]
  },
  {
   "s": 7.156,
   "e": 9.073,
   "text": "これは「遮光器土偶」。",
   "hl": [
    "遮光器土偶"
   ]
  },
  {
   "s": 9.073,
   "e": 11.818,
   "text": "縄文時代の終わりごろに\n作られました。",
   "hl": [
    "縄文時代"
   ]
  },
  {
   "s": 11.818,
   "e": 16.187,
   "text": "一番有名なものは、明治時代に\n亀ヶ岡遺跡で見つかりました。",
   "hl": [
    "亀ヶ岡遺跡"
   ]
  },
  {
   "s": 16.187,
   "e": 19.915,
   "text": "高さは三十四センチほど。\n中は空洞になっています。",
   "hl": [
    "空洞"
   ]
  },
  {
   "s": 19.915,
   "e": 23.408,
   "text": "今は東京国立博物館に\n収められています。",
   "hl": [
    "東京国立博物館"
   ]
  },
  {
   "s": 23.408,
   "e": 27.383,
   "text": "「遮光器」とは、北極の人々が\n使う雪よけの眼鏡のこと。",
   "hl": [
    "雪よけの眼鏡"
   ]
  },
  {
   "s": 27.383,
   "e": 31.087,
   "text": "目の形がその眼鏡に似ていたので、\nこの名前がつきました。",
   "hl": [
    "名前"
   ]
  },
  {
   "s": 31.087,
   "e": 34.776,
   "text": "やがて、「宇宙服を着た宇宙人だ」\nという説まで広まりました。",
   "hl": [
    "宇宙人"
   ]
  },
  {
   "s": 34.776,
   "e": 38.113,
   "text": "丸くふくらんだ体や肩が、\n宇宙服に見えたのです。",
   "hl": [
    "宇宙服"
   ]
  },
  {
   "s": 38.113,
   "e": 39.847,
   "text": "しかし研究者の多くは、",
   "hl": []
  },
  {
   "s": 39.847,
   "e": 42.867,
   "text": "閉じた目を大きく表したものだと\n考えています。",
   "hl": [
    "閉じた目"
   ]
  },
  {
   "s": 42.867,
   "e": 46.724,
   "text": "胸やお腹のふくらみから、\n女性の姿だという見方もあります。",
   "hl": [
    "女性の姿"
   ]
  },
  {
   "s": 46.724,
   "e": 50.584,
   "text": "そして不思議なことに、\nこの土偶は左足が欠けています。",
   "hl": [
    "左足"
   ]
  },
  {
   "s": 50.584,
   "e": 53.823,
   "text": "土偶の多くは、\nこうして壊れた姿で見つかります。",
   "hl": [
    "壊れた姿"
   ]
  },
  {
   "s": 53.823,
   "e": 55.338,
   "text": "病気やけがの\n身代わりに、",
   "hl": [
    "わざと壊した"
   ]
  },
  {
   "s": 55.338,
   "e": 58.255,
   "text": "わざと壊したのではないか、\nという説もあります。",
   "hl": [
    "わざと壊した"
   ]
  },
  {
   "s": 58.255,
   "e": 61.103,
   "text": "けれど、本当の答えは、\nまだわかっていません。",
   "hl": [
    "まだわかっていません"
   ]
  },
  {
   "s": 61.103,
   "e": 65.837,
   "text": "三千年前の人々は、この目で\n何を見ていたのでしょうか。",
   "hl": [
    "何を見ていた"
   ]
  }
 ],
