 "subs": [
  {
   "s": 0.1,
   "e": 3.513,
   "text": "安政二年、\n一八五五年の秋の夜。",
   "hl": [
    "一八五五年"
   ]
  },
  {
   "s": 3.513,
   "e": 6.076,
   "text": "江戸の町を、\n大きな地震が襲いました。",
   "hl": []
  },
  {
   "s": 6.076,
   "e": 8.634,
   "text": "地震が起きたのは、\n夜の十時ごろ。",
   "hl": [
    "夜の十時ごろ"
   ]
  },
  {
   "s": 8.634,
   "e": 12.677,
   "text": "被害は、隅田川沿いの下町で\n特に大きかったといいます。",
   "hl": [
    "下町"
   ]
  },
  {
   "s": 12.677,
   "e": 14.52,
   "text": "家々は倒れ、\n火事が広がり、",
   "hl": []
  },
  {
   "s": 14.52,
   "e": 17.247,
   "text": "一万人近くが\n亡くなったともいわれます。",
   "hl": [
    "一万人近く"
   ]
  },
  {
   "s": 17.247,
   "e": 18.532,
   "text": "当時の人々は、",
   "hl": []
  },
  {
   "s": 18.532,
   "e": 22.366,
   "text": "地震は地下に住む大鯰が暴れて\n起きると信じていました。",
   "hl": [
    "大鯰"
   ]
  },
  {
   "s": 22.366,
   "e": 24.594,
   "text": "ふだんは鹿島神宮の\n神さまが、",
   "hl": []
  },
  {
   "s": 24.594,
   "e": 26.839,
   "text": "要石で鯰を\n押さえています。",
   "hl": [
    "要石"
   ]
  },
  {
   "s": 26.839,
   "e": 29.827,
   "text": "ところが地震が\n起きたのは旧暦の十月、",
   "hl": []
  },
  {
   "s": 29.827,
   "e": 32.856,
   "text": "神さまたちが出雲へ\n出かける「神無月」でした。",
   "hl": [
    "神無月"
   ]
  },
  {
   "s": 32.856,
   "e": 35.713,
   "text": "留守のすきに、\n鯰が暴れたというわけです。",
   "hl": []
  },
  {
   "s": 35.713,
   "e": 39.653,
   "text": "鹿島の神さまが、馬で急いで\n戻ってくる姿も描かれています。",
   "hl": [
    "馬で急いで"
   ]
  },
  {
   "s": 39.653,
   "e": 40.721,
   "text": "地震のあと、",
   "hl": []
  },
  {
   "s": 40.721,
   "e": 44.471,
   "text": "江戸では鯰を描いた「鯰絵」\nが次々と売り出されました。",
   "hl": [
    "鯰絵"
   ]
  },
  {
   "s": 44.471,
   "e": 48.586,
   "text": "地震から数日のうちに、\n町には鯰絵があふれたといいます。",
   "hl": [
    "数日のうちに"
   ]
  },
  {
   "s": 48.586,
   "e": 51.499,
   "text": "その数は、\n二百種類以上ともいわれます。",
   "hl": [
    "二百種類以上"
   ]
  },
  {
   "s": 51.499,
   "e": 55.381,
   "text": "そのほとんどは、作者の名前もない、\n急いで刷られた絵でした。",
   "hl": [
    "作者の名前もない"
   ]
  },
  {
   "s": 55.381,
   "e": 58.237,
   "text": "怒った町の人々が\n鯰をこらしめる絵もあれば、",
   "hl": [
    "こらしめる"
   ]
  },
  {
   "s": 58.237,
   "e": 60.808,
   "text": "復興の仕事で、\n町の人々にお金が回り、",
   "hl": [
    "お金が回り"
   ]
  },
  {
   "s": 60.808,
   "e": 62.701,
   "text": "それを\n喜ぶ絵もあります。",
   "hl": [
    "喜ぶ"
   ]
  },
  {
   "s": 62.701,
   "e": 65.246,
   "text": "鯰絵は、恐ろしい災害を\n笑いに変えて、",
   "hl": [
    "笑い"
   ]
  },
  {
   "s": 65.246,
   "e": 69.346,
   "text": "人々が立ち直るための\n力だったのかもしれません。",
   "hl": [
    "立ち直る"
   ]
  }
 ],
