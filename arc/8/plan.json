 "subs": [
  {
   "s": 0.1,
   "e": 3.358,
   "text": "お店の入り口で、片手を\n上げて客を招く招き猫。",
   "hl": [
    "片手を上げて"
   ]
  },
  {
   "s": 3.358,
   "e": 5.817,
   "text": "その始まりには、\nいくつもの説があります。",
   "hl": []
  },
  {
   "s": 5.817,
   "e": 9.631,
   "text": "よく知られているのは、\n東京・世田谷の豪徳寺の話です。",
   "hl": [
    "豪徳寺"
   ]
  },
  {
   "s": 9.631,
   "e": 10.808,
   "text": "江戸時代のはじめ、",
   "hl": []
  },
  {
   "s": 10.778,
   "e": 13.746,
   "text": "彦根藩主の井伊直孝が\n寺の前を通りかかると、",
   "hl": [
    "井伊直孝"
   ]
  },
  {
   "s": 13.716,
   "e": 15.697,
   "text": "一匹の猫が\n手招きをしました。",
   "hl": [
    "手招き"
   ]
  },
  {
   "s": 15.697,
   "e": 18.284,
   "text": "寺に入ると、すぐに\n激しい雷雨が降り出し、",
   "hl": [
    "雷雨"
   ]
  },
  {
   "s": 18.254,
   "e": 20.486,
   "text": "直孝は難を\n逃れたといいます。",
   "hl": []
  },
  {
   "s": 20.486,
   "e": 22.88,
   "text": "これをきっかけに寺は\n井伊家に大切にされ、",
   "hl": []
  },
  {
   "s": 22.85,
   "e": 26.587,
   "text": "「豪徳寺」という名前も、\n直孝の戒名からとられました。",
   "hl": [
    "戒名"
   ]
  },
  {
   "s": 26.587,
   "e": 27.886,
   "text": "今では境内に、",
   "hl": []
  },
  {
   "s": 27.856,
   "e": 30.947,
   "text": "数えきれないほどの招き猫が\n奉納されています。",
   "hl": [
    "招き猫"
   ]
  },
  {
   "s": 30.947,
   "e": 33.535,
   "text": "もう一つが、\n浅草の今戸焼の話です。",
   "hl": [
    "今戸焼"
   ]
  },
  {
   "s": 33.535,
   "e": 35.831,
   "text": "江戸時代の終わり、\n貧しいおばあさんが、",
   "hl": []
  },
  {
   "s": 35.801,
   "e": 38.643,
   "text": "夢に出てきた猫の姿を\n焼き物にして売ったところ、",
   "hl": [
    "夢に出てきた猫"
   ]
  },
  {
   "s": 38.613,
   "e": 40.415,
   "text": "大評判になったといわれます。",
   "hl": []
  },
  {
   "s": 40.415,
   "e": 42.824,
   "text": "一八五二年の\n浮世絵にも、",
   "hl": [
    "浮世絵"
   ]
  },
  {
   "s": 42.794,
   "e": 45.017,
   "text": "浅草で「丸〆猫」\nという招き猫が",
   "hl": [
    "丸〆猫"
   ]
  },
  {
   "s": 44.987,
   "e": 46.831,
   "text": "売られる様子が\n描かれています。",
   "hl": []
  },
  {
   "s": 46.831,
   "e": 49.806,
   "text": "明治時代以降、招き猫は\n全国のお店に広まり、",
   "hl": []
  },
  {
   "s": 49.776,
   "e": 52.965,
   "text": "愛知県の常滑や瀬戸は、\n今も大きな産地です。",
   "hl": [
    "常滑や瀬戸"
   ]
  },
  {
   "s": 52.965,
   "e": 54.8,
   "text": "右手を\n上げた猫はお金を、",
   "hl": [
    "お金"
   ]
  },
  {
   "s": 54.77,
   "e": 57.535,
   "text": "左手を上げた猫は人を\n招くともいわれます。",
   "hl": [
    "人を招く"
   ]
  },
  {
   "s": 57.535,
   "e": 59.592,
   "text": "小さな猫に願いを\n託す気持ちは、",
   "hl": [
    "願い"
   ]
  },
  {
   "s": 59.562,
   "e": 62.678,
   "text": "江戸の\n昔から変わっていないのです。",
   "hl": []
  }
 ],
